{
	"name": "fan",
	"main": "worker.js",
	"compatibility_date": "2026-09-19",
	
	// 路由配置 - 使用自定义域名
	"routes": [
		{
			"pattern": "fan.zztxer.dpdns.org/*",
			"zone_name": "zztxer.dpdns.org"
		}
	],

	"vars": {
		"WIN_VERSION_CODE": "1",
		"WIN_VERSION_NAME": "1.0.0",
		"WIN_DOWNLOAD_URL": "https://starbrowser.zztxer.dpdns.org",
		"WIN_CHANGELOG": "1. 【创建】初始版本，支持基础功能"
	},
	
	"kv_namespaces": [
		{
			"binding": "FAN",
			"id": "dd7e2c08faa440afa778d3414bffce4a"
		}
	]
}